# Copy this file to settings/.env and change the values.
# local -> settings/env/local.py (SQLite), prod -> settings/env/prod.py (PostgreSQL)
BLOG_ENV_ID=local
BLOG_SECRET_KEY=change-me-to-a-long-random-string

# Only needed when BLOG_ENV_ID=prod
BLOG_POSTGRES_DB=blog
BLOG_POSTGRES_USER=postgres
BLOG_POSTGRES_PASSWORD=postgres
BLOG_POSTGRES_HOST=localhost
BLOG_POSTGRES_PORT=5432
